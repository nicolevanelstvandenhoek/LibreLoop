{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ can't reconnect to your FreeStyle Libre 3. Scan the sensor again to resume CGM readings. If it was recently inserted and keeps failing, the sensor may be defective — replace it." : {
      "comment" : "Reconnect-failed alert body (1: appName)",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan niet opnieuw verbinden met je FreeStyle Libre 3. Scan de sensor opnieuw om CGM-metingen te hervatten. Is de sensor net geplaatst en blijft dit mislukken, dan is de sensor mogelijk defect — vervang hem."
          }
        }
      }
    },
    "Active" : {
