    "Do not remove the cap from the sensor applicator until you're ready to apply the sensor." : {
      "comment" : "Apply-sensor cap instruction",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal de dop pas van de sensorapplicator als je klaar bent om de sensor te plaatsen."
          }
        }
      }
    },
    "Do not reuse the cap. The sterile barrier is broken once removed." : {
      "comment" : "Apply-sensor help step 3 note",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de dop niet opnieuw. Zodra hij eraf is, is de steriele afsluiting verbroken."
